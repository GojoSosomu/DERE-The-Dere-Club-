                {
                  "type": "speaker",
                  "speaker": "narrator",
                  "text": "The clubroom settles back into its quiet rhythm."
                },
                {
                  "type": "speaker",
                  "speaker": "narrator",
                  "text": "Perhaps this place is worth coming back to."
                }
              ]
