{
  "id": "year1",
  "start": "school_intro",
  
  "scenes": {
    "school_intro": {
      "background": "hallway",
      "dialogue": [
        {
          "type": "speaker",
          "speaker": "narrator",
          "stage": {},
          "text": "The first day of school always feels longer than it should."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "New classrooms. New faces. New routines."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Everything feels unfamiliar."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "The hallway is crowded with students trying to find their classrooms before the bell rings."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "You check the schedule again."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Room 204."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "At least, that's what it says."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "stage": {
            "right": {
              "character": "penny",
              "emotion": "neutral"
            }
          },
          "text": "You're lost, aren't you?",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": 2
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Don't answer that."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "I can already tell."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "You're looking at that schedule like it's written in another language."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Penny folds her arms."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Room 204 is upstairs."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Stairs are over there."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Try not to get lost again."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Penny starts walking toward the stairs."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "...You're coming, right?",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": 3
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Penny doesn't wait for an answer."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Come on.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": -5
                }
              ]
            }
          ]
        },
        {
          "type": "goto",
          "scene": "first_class"
        }
      ]
    },
    "first_class": {
      "background": "classroom",
      "dialogue": [
        {
          "type": "speaker",
          "speaker": "narrator",
          "stage": {},
          "text": "The classroom is already filling up."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Penny takes a seat near the window."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "stage": {
            "left": {
              "character": "penny",
              "emotion": "neutral"
            }
          },
          "text": "You can sit there.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": 2
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Unless you have somewhere else to be."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "The teacher enters the classroom."
        },
        {
          "type": "speaker",
          "speaker": "teacher",
          "text": "Good morning, everyone."
        },
        {
          "type": "speaker",
          "speaker": "teacher",
          "text": "Before we begin, I'd like to welcome our new student."
        },
        {
          "type": "speaker",
          "speaker": "teacher",
          "text": "Please make them feel welcome."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Already did.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": 1
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "teacher",
          "text": "Penny."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "What?"
        },
        {
          "type": "speaker",
          "speaker": "teacher",
          "text": "Let me finish."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "...Fine."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "The lesson begins."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "For the next several hours, the day passes normally."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Classes."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Notes."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Introductions."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "And eventually, lunch."
        },
        {
          "type": "goto",
          "scene": "lunch"
        }
      ]
    },
    "lunch": {
      "background": "hallway",
      "dialogue": [
        {
          "type": "speaker",
          "speaker": "narrator",
          "stage": {},
          "text": "The hallway becomes quieter during lunch."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Students gather in groups, talking about classes, teachers, and clubs."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "stage": {
            "right": {
              "character": "penny",
              "emotion": "neutral"
            }
          },
          "text": "Hey.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": 1
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "You survived the morning."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Congratulations."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "So..."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Have you decided what club you're joining?"
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Penny waits."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "You don't have one."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Of course you don't."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Come on.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": 2
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "I'll show you."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Penny starts walking down the hallway."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "There are a lot of clubs here."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Sports, academic stuff, music..."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "And the Creative Arts Club."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "That's the one I'm in.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": 3
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Don't get the wrong idea."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "I just like fashion and styling."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "That's all."
        },
        {
          "type": "goto",
          "scene": "clubroom"
        }
      ]
    },
    "clubroom": {
      "background": "clubroom",
      "dialogue": [
        {
          "type": "speaker",
          "speaker": "narrator",
          "stage": {},
          "text": "Penny opens the clubroom door."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "The Creative Arts Club room is quieter than expected."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Books, papers, sketches, and unfinished projects cover several tables."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "stage": {
            "left": {
              "character": "yuri",
              "emotion": "neutral"
            },
            "right": {
              "character": "penny",
              "emotion": "neutral"
            }
          },
          "text": "...",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "yuri",
                  "amount": 1
                },
                {
                  "character": "penny",
                  "amount": 1
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "You're early."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "They're new."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "I brought them here.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": 2
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "I see."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Yuri lowers her gaze back to the book in her hands."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Don't mind her."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "She's always reading something."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "It's a book."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "I know what a book is."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "You seemed unsure.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": -1
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "I wasn't."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Another student sits quietly at a table across the room."
        },
        {
          "type": "speaker",
          "speaker": "erika",
          "stage": {
            "left": {
              "character": "yuri",
              "emotion": "neutral"
            },
            "center": {
              "character": "erika",
              "emotion": "neutral"
            },
            "right": {
              "character": "penny",
              "emotion": "neutral"
            }
          },
          "text": "Penny.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "erika",
                  "amount": 1
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "What?"
        },
        {
          "type": "speaker",
          "speaker": "erika",
          "text": "You forgot to introduce them."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "I was getting to that."
        },
        {
          "type": "speaker",
          "speaker": "erika",
          "text": "You weren't.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": -1
                },
                {
                  "character": "erika",
                  "amount": 2
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "...Whatever."
        },
        {
          "type": "speaker",
          "speaker": "erika",
          "text": "Welcome to the Creative Arts Club.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "erika",
                  "amount": 3
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Erika looks toward the protagonist."
        },
        {
          "type": "speaker",
          "speaker": "erika",
          "text": "You don't have to decide immediately."
        },
        {
          "type": "speaker",
          "speaker": "erika",
          "text": "You can look around first."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "See?"
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "It's not that serious."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "It can be.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "yuri",
                  "amount": 2
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Yuri."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "What?"
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "You're making it sound scary."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "I didn't mean to."
        },
        {
          "type": "speaker",
          "speaker": "erika",
          "text": "You aren't helping.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "erika",
                  "amount": 1
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "Sorry."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Yuri returns her attention to her book."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "Anyway."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "If you're looking for something to do, you could join us.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "penny",
                  "amount": 3
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "We're not exactly strict."
        },
        {
          "type": "speaker",
          "speaker": "erika",
          "text": "There aren't many requirements."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "You can read.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "yuri",
                  "amount": 1
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "Write."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "Draw."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "Create something."
        },
        {
          "type": "speaker",
          "speaker": "yuri",
          "text": "Or simply stay."
        },
        {
          "type": "speaker",
          "speaker": "penny",
          "text": "That's basically the whole club."
        },
        {
          "type": "speaker",
          "speaker": "erika",
          "text": "We're here to create.",
          "effects": [
            {
              "type": "relationship",
              "relations": [
                {
                  "character": "erika",
                  "amount": 2
                }
              ]
            }
          ]
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "The three students remain in the room."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Penny stands beside the door."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Yuri sits with her book."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "Erika quietly observes."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "For the first time today, you aren't being told where to go."
        },
        {
          "type": "speaker",
          "speaker": "narrator",
          "text": "The choice is yours."
        },
        {
          "type": "choice",
          "choices": [
            {
              "text": "Join the Creative Arts Club.",
              "dialogue": [
                {
                  "type": "speaker",
                  "speaker": "penny",
                  "text": "Really?",
                  "effects": [
                    {
                      "type": "relationship",
                      "relations": [
                        {
                          "character": "penny",
                          "amount": 4
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "speaker",
                  "speaker": "penny",
                  "text": "I mean..."
                },
                {
                  "type": "speaker",
                  "speaker": "penny",
                  "text": "Sure."
                },
                {
                  "type": "speaker",
                  "speaker": "penny",
                  "text": "Welcome, I guess."
                },
                {
                  "type": "speaker",
                  "speaker": "yuri",
                  "text": "I'm glad.",
                  "effects": [
                    {
                      "type": "relationship",
                      "relations": [
                        {
                          "character": "yuri",
                          "amount": 4
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "speaker",
                  "speaker": "erika",
                  "text": "Then it's decided.",
                  "effects": [
                    {
                      "type": "relationship",
                      "relations": [
                        {
                          "character": "erika",
                          "amount": 4
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "speaker",
                  "speaker": "narrator",
                  "text": "Penny moves away from the door and takes a seat."
                },
                {
                  "type": "speaker",
                  "speaker": "penny",
                  "stage": {
                    "left": {
                      "character": "penny",
                      "emotion": "neutral"
                    },
                    "center": {
                      "character": "erika",
                      "emotion": "neutral"
                    },
                    "right": {
                      "character": "yuri",
                      "emotion": "neutral"
                    }
                  },
                  "text": "Guess you're one of us now.",
                  "effects": [
                    {
                      "type": "relationship",
                      "relations": [
                        {
                          "character": "penny",
                          "amount": 3
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "speaker",
                  "speaker": "narrator",
                  "text": "The room feels a little different."
                },
                {
                  "type": "speaker",
                  "speaker": "narrator",
                  "text": "Not because anything changed."
                },
                {
                  "type": "speaker",
                  "speaker": "narrator",
                  "text": "But because you finally have somewhere to belong."
                }
              ]
            },
            {
              "text": "Look around first.",
              "dialogue": [
                {
                  "type": "speaker",
                  "speaker": "erika",
                  "text": "That's fine.",
                  "effects": [
                    {
                      "type": "relationship",
                      "relations": [
                        {
                          "character": "erika",
                          "amount": 2
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "speaker",
                  "speaker": "erika",
                  "text": "Take your time."
                },
                {
                  "type": "speaker",
                  "speaker": "penny",
                  "text": "Just don't take forever.",
                  "effects": [
                    {
                      "type": "relationship",
                      "relations": [
                        {
                          "character": "penny",
                          "amount": -1
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "speaker",
                  "speaker": "yuri",
                  "text": "You can stay as long as you'd like.",
                  "effects": [
                    {
                      "type": "relationship",
                      "relations": [
                        {
                          "character": "yuri",
                          "amount": 3
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "speaker",
                  "speaker": "narrator",
                  "text": "Penny sits down near the table."
                },
                {
                  "type": "speaker",
                  "speaker": "penny",
                  "stage": {
                    "left": {
                      "character": "penny",
                      "emotion": "neutral"
                    },
                    "center": {
                      "character": "erika",
                      "emotion": "neutral"
                    },
                    "right": {
                      "character": "yuri",
                      "emotion": "neutral"
                    }
